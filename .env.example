# ==============================================================================
# AZ AIRLINES: APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Oracle Database Connection (Oracle 23ai Free / Autonomous DB)
ORACLE_USER=airline
ORACLE_PASSWORD=airline123
ORACLE_DSN=localhost:1521/FREEPDB1

# 2. JWT Authentication Secret Key (Replace with a random 256-bit secret in production)
JWT_SECRET_KEY=oracle-airline-super-secure-jwt-secret-key-2026

# 3. CORS Allowed Origins (Comma-separated list of permitted origins, or * for dev)
# Example for production: https://airline101.vercel.app,http://localhost:3000,http://127.0.0.1:8000
CORS_ORIGINS=*

# 4. Server Port (Default: 8000)
PORT=8000

# 5. Default Credentials Template (Do not put real passwords here)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin1@airline.com
ADMIN_PASSWORD=your_admin_password_here
PASSENGER_EMAIL=passenger@example.com
PASSENGER_PASSWORD=your_passenger_password_here


